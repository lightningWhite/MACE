{
  "name": "mace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The MACE web client: a renderer for the engine's event stream.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "assets": "node scripts/pyodide.mjs && node scripts/bundle.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:pyodide": "node scripts/pyodide-check.mjs",
    "test": "vitest run",
    "watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "pyodide": "^314.0.6",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
